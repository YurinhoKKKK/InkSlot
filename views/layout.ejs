<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InkSlot</title>
    
    <!-- Estilos gerais (só carregam se o layout estiver ativo) -->
    <% if (typeof layout === 'undefined' || layout !== false) { %>
        <link rel="stylesheet" href="assets/css/style.css">
        <link href="./styles/home.css" rel="stylesheet">
        <link rel="stylesheet" href="./styles/style.css" rel="stylesheet">
        <link href="./styles/fonts.css" rel="stylesheet">
        <link href="./styles/media.css" rel="stylesheet">
        <link href="./styles/footer.css" rel="stylesheet">

        <!-- FontAwesome -->
        <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet"/>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <% } %>
</head>
<body>
    <% if (typeof layout === 'undefined' || layout !== false) { %>
    <header>
        <div id="title">
            <h2><span>Ink</span>Slot</h2>
        </div>
             
        <ul>
            <a href="/"><li>Início</li></a>
            <a href="/home"><li>Tatuadores</li></a>
            <a href="https://maps.app.goo.gl/gQKYLmvYmhdkrKo66" target="_blank" class="footer-link">Nos Encontre</a>
            <a href="#footer"><li>Contato</li></a>
            <a href="/auth/cadastro" id="inscreva-se-btn"><li>Cadastrar-se</li></a>
        </ul>
    </header>
    <% } %>

    <%- body %>

    <% if (typeof layout === 'undefined' || layout !== false) { %>
    <footer id="footer">
        <div id="footer_content">
            <div id="footer_contacts">
                <h1>InkSlot</h1>
                <p>Agende agora sua próxima sessão!</p>
  
                <div id="footer_social_media">
                    <a href="#" class="footer-link" id="instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
  
                    <a href="#" class="footer-link" id="facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
  
                    <a href="#" class="footer-link" id="whatsapp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>
            
            <ul class="footer-list">
                <li>
                    <h3>Menu</h3>
                </li>
                <li>
                    <a href="#" class="footer-link">Início</a>
                </li>
                <li>
                    <a href="#" class="footer-link">Tatuadores</a>
                </li>
                <li>
                    <a href="https://maps.app.goo.gl/gQKYLmvYmhdkrKo66" target="_blank" class="footer-link">Nos Encontre</a>
                </li>
            </ul>
    
        </div>
    </footer>
    <% } %>

    <script src="mobile-navbar.js"></script>
</body>
</html>
